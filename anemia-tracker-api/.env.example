NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/anemia_tracker
JWT_SECRET=replace-with-a-long-random-development-secret
CORS_ORIGINS=http://localhost:8081

# Development-only OTP behavior. Never enable ALLOW_DEV_OTP in production.
OTP_SMS_PROVIDER=mock
ALLOW_DEV_OTP=true

# Required for school password-reset email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Required for parent OTP delivery in production when OTP_SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
